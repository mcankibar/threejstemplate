{
  "name": "three-js-template",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "playable": {
    "title": "ThreeJS Template Playable"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "export": "node playable/export/cli.js",
    "export:all": "node playable/export/cli.js --networks=all",
    "format": "prettier --write \"{src,lib,playable}/**/*.js\" --config .prettierrc.json"
  },
  "dependencies": {
    "@esotericsoftware/spine-threejs": "^4.2.43",
    "fflate": "^0.8.2",
    "gsap": "^3.6.1",
    "lodash-es": "^4.17.21",
    "three": "0.162.0"
  },
  "devDependencies": {
    "prettier": "2.7.1",
    "tweakpane": "^4.0.4",
    "vite": "^6.3.0"
  }
}
